{
  "multipart": [
    {
      "apply": {
        "model": "stalker-mod:block/pale_moss_carpet"
      },
      "when": {
        "OR": [
          { "bottom": "true" },
          { "bottom": "false", "north": "none", "east": "none", "south": "none", "west": "none" }
        ]
      }
    },
    {
      "apply": {
        "model": "stalker-mod:block/pale_moss_carpet_side_small"
      },
      "when": {
        "north": "low"
      }
    },
    {
      "apply": {
        "model": "stalker-mod:block/pale_moss_carpet_side_small",
        "uvlock": true,
        "y": 90
      },
      "when": {
        "east": "low"
      }
    },
    {
      "apply": {
        "model": "stalker-mod:block/pale_moss_carpet_side_small",
        "uvlock": true,
        "y": 180
      },
      "when": {
        "south": "low"
      }
    },
    {
      "apply": {
        "model": "stalker-mod:block/pale_moss_carpet_side_small",
        "uvlock": true,
        "y": 270
      },
      "when": {
        "west": "low"
      }
    }
  ]
}